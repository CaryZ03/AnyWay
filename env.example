# =================================================================
# AnyWay AI Agent Platform - 环境变量配置示例
# =================================================================
# 复制此文件为 .env 并修改相应的值
# 命令: cp env.example .env
# =================================================================

# ===== Django 配置 =====
# Django 密钥（生产环境必须修改！）
# 生成命令: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-super-secret-key-here-change-this-in-production

# 允许访问的主机（使用逗号分隔）
# 示例: ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com,your-server-ip
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS 允许的源（使用逗号分隔）
# 生产环境示例: CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# 开发环境示例: CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:18080
CORS_ALLOWED_ORIGINS=http://localhost:18080

# ===== 数据库配置 =====
# MySQL Root 密码（强烈建议修改！）
MYSQL_ROOT_PASSWORD=StrongRootPassword123!

# MySQL 应用数据库密码（强烈建议修改！）
MYSQL_PASSWORD=StrongAppPassword456!

# ===== AI 服务配置 =====
# 火山引擎（豆包）API Key（必须配置才能使用AI功能）
# 获取地址: https://console.volcengine.com/ark
ARK_API_KEY=your-volcano-api-key-here

# 火山引擎 API Base URL（默认为北京地域）
ARK_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# OpenAI API Key（可选，作为备用）
# OPENAI_API_KEY=sk-your-openai-api-key-here

# ===== 可选配置 =====
# Redis配置（通常使用默认值即可）
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_DB=0

# Celery配置（通常使用默认值即可）
# CELERY_BROKER_URL=redis://redis:6379/1
# CELERY_RESULT_BACKEND=redis://redis:6379/2

# ===== 生产环境额外配置 =====
# 邮件服务配置（用于发送通知等）
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-email-password
# EMAIL_USE_TLS=True

# 日志级别（DEBUG, INFO, WARNING, ERROR, CRITICAL）
# LOG_LEVEL=INFO

# 文件上传限制（MB）
# MAX_UPLOAD_SIZE=100

